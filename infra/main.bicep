targetScope = 'subscription'

@minLength(1)
@maxLength(64)
@description('azd environment name; used to derive resource names.')
param environmentName string

@minLength(1)
@description('Azure region for all resources.')
param location string

@description('Application (client) id of the Stay API app registration. Empty disables built-in auth (local-style roles via X-Local-Roles; do not do that in a real deployment).')
param apiAppClientId string = ''

@description('Tenant id that issues tokens for the API (defaults to the deploying tenant).')
param apiTenantId string = tenant().tenantId

@secure()
@description('Base64 PKCS#8 ECDSA P-256 private key used to sign quotes. Generated by scripts/new-signing-key.ps1.')
param quoteSigningKey string = ''

var token = toLower(uniqueString(subscription().id, environmentName, location))
var tags = { 'azd-env-name': environmentName, project: 'mcp-layer-rules-azure' }

resource rg 'Microsoft.Resources/resourceGroups@2024-03-01' = {
  name: 'rg-${environmentName}'
  location: location
  tags: tags
}

module resources 'resources.bicep' = {
  name: 'resources'
  scope: rg
  params: {
    location: location
    tags: tags
    token: token
    apiAppClientId: apiAppClientId
    apiTenantId: apiTenantId
    quoteSigningKey: quoteSigningKey
  }
}

output AZURE_LOCATION string = location
output AZURE_RESOURCE_GROUP string = rg.name
output STAY_API_URL string = resources.outputs.apiUrl
output STAY_MCP_URL string = resources.outputs.mcpUrl
output STAY_MCP_PRINCIPAL_ID string = resources.outputs.mcpPrincipalId
output STAY_API_APP_NAME string = resources.outputs.apiAppName
output STAY_MCP_APP_NAME string = resources.outputs.mcpAppName
