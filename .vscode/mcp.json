{
  "inputs": [
    {
      "type": "promptString",
      "id": "functions-mcp-extension-system-key",
      "description": "Azure Functions MCP Extension System Key (mcp_extension) of the staymcp app",
      "password": true
    }
  ],
  "servers": {
    "stay-mcp-local": {
      "type": "http",
      "url": "http://localhost:7072/runtime/webhooks/mcp"
    },
    "stay-mcp-azure": {
      "type": "http",
      "url": "https://<func-staymcp-...>.azurewebsites.net/runtime/webhooks/mcp",
      "headers": {
        "x-functions-key": "${input:functions-mcp-extension-system-key}"
      }
    }
  }
}
